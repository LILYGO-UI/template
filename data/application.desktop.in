[Desktop Entry]
Type=Application
Name=@LILYGO_UI_APP_NAME@
Comment=@LILYGO_UI_APP_DESCRIPTION@
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@LILYGO_UI_EXECUTABLE_NAME@ --mode=auto
Icon=@LILYGO_UI_APP_ID@
Terminal=false
Categories=Utility;
StartupNotify=true
Actions=Phone;Desktop;

[Desktop Action Phone]
Name=Phone mode
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@LILYGO_UI_EXECUTABLE_NAME@ --mode=phone

[Desktop Action Desktop]
Name=Desktop mode
Exec=@CMAKE_INSTALL_FULL_BINDIR@/@LILYGO_UI_EXECUTABLE_NAME@ --mode=desktop
